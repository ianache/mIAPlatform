{
    "name": "evaluar_test_case",
    "tools": [
        {
            "name": "get_testcase",
            "description": "Obtiene la descripción de un issue de GitLab para evaluar su calidad como caso de prueba. Usa el nombre completo 'evaluar_test_case.get_testcase' al llamar esta herramienta.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "project_id": {
                        "type": "integer",
                        "description": "El ID numérico del proyecto en GitLab."
                    },
                    "issue_id": {
                        "type": "integer",
                        "description": "El ID (iid) del issue dentro del proyecto."
                    }
                },
                "required": [
                    "project_id",
                    "issue_id"
                ]
            }
        },
        {
            "name": "find_project",
            "description": "Buscar proyecto en Gitlab por su nombre. Devuelve datos basicos del proyecto (id, name, description)",
            "input_schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "nombre del proyecto"
                    }
                },
                "required": [
                    "name"
                ]
            }
        },
        {
            "name": "find_userstory",
            "description": "Busca una user story en proyecto en Gitlab por su codigo. Devuelve datos basicos de la user story (id, name, description)",
            "input_schema": {
                "type": "object",
                "properties": {
                    "project_id": {
                        "type": "integer",
                        "description": "id del proyecto"
                    },
                    "userstory_code": {
                        "type": "string",
                        "description": "codigo de la userstory"
                    }
                },
                "required": [
                    "project_id",
                    "userstory_code"
                ]
            }
        }
    ]
}